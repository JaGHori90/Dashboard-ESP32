<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>2be9ab3a-65ea-49a5-b50c-5392715c12e0</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.31" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.31">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Npgsql" Version="8.0.9" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
    <!-- Explizit neuer als das Swashbuckle-Meta-Paket: swagger-ui-dist < 5.19.0 (in 9.0.6 gebündelt)
         kennt "openapi": "3.0.4" nicht (das neuere Microsoft.OpenApi schreibt diese Version statt
         "3.0.1") und zeigt "Unable to render this definition". SwaggerUI ist ein reines
         UI-Middleware-Paket ohne Abhängigkeit zu Microsoft.OpenApi, kann also unabhängig von
         Swagger/SwaggerGen höher gezogen werden, ohne deren Microsoft.OpenApi-2.x-Breaking-Change
         mitzunehmen. -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Persistence\Persistence.csproj" />
  </ItemGroup>

</Project>
