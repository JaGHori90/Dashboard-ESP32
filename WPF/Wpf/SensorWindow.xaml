<Window x:Class="Wpf.SensorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf"
        mc:Ignorable="d"
        Title="ESP32 Sensor-Dashboard" Height="480" Width="700">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Gerät:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Command="{Binding CmdRefresh}" DockPanel.Dock="Right" Padding="10,2">Aktualisieren</Button>
            <TextBox Text="{Binding DeviceId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="Letzter Messwert" FontWeight="Bold" Margin="0,0,0,5"/>

        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <UniformGrid Columns="4">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Temperatur"/>
                    <TextBlock Text="{Binding Latest.Temperature, StringFormat={}{0:0.0} °C}" FontSize="18"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Luftfeuchtigkeit"/>
                    <TextBlock Text="{Binding Latest.Humidity, StringFormat={}{0:0.0} %}" FontSize="18"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Druck"/>
                    <TextBlock Text="{Binding Latest.Pressure, StringFormat={}{0:0.0} hPa}" FontSize="18"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Zeitpunkt"/>
                    <TextBlock Text="{Binding Latest.Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" FontSize="18"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Readings}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Zeitpunkt" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="160"/>
                <DataGridTextColumn Header="Gerät" Binding="{Binding DeviceId}" Width="140"/>
                <DataGridTextColumn Header="Temp (°C)" Binding="{Binding Temperature, StringFormat={}{0:0.0}}" Width="100"/>
                <DataGridTextColumn Header="Feuchte (%)" Binding="{Binding Humidity, StringFormat={}{0:0.0}}" Width="100"/>
                <DataGridTextColumn Header="Druck (hPa)" Binding="{Binding Pressure, StringFormat={}{0:0.0}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Margin="0,10,0,0" Foreground="Gray"/>
    </Grid>
</Window>
