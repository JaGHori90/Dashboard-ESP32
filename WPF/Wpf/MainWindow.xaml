<Window x:Class="Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="Sensor Dashboard" Height="980" Width="820" Background="#0B0F1A">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock DockPanel.Dock="Right" Text="{Binding DateTimeText}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"></TextBlock>
            <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource StatusDotStyle}"></Ellipse>
                <TextBlock Text="{Binding HeaderText}" Style="{StaticResource HeaderTitleStyle}"></TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- Current values -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Style="{StaticResource StatBulletStyle}" Fill="#34D8B8"></Rectangle>
                        <TextBlock Text="Temperatur" Style="{StaticResource StatLabelStyle}" Foreground="#34D8B8"></TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TemperatureText}" Style="{StaticResource StatValueStyle}"></TextBlock>
                        <TextBlock Text="°C" Foreground="#34D8B8" FontSize="18" VerticalAlignment="Bottom"></TextBlock>
                    </StackPanel>

                    <TextBlock Text="{Binding TemperatureDeltaText}" Style="{StaticResource StatSubStyle}" Foreground="#34D8B8"></TextBlock>
                    <TextBlock Text="{Binding TemperatureRatingText}" Style="{StaticResource StatSubStyle}"></TextBlock>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource StatDividerStyle}" Margin="0,0,20,0"></Border>

                <StackPanel Grid.Column="2" Margin="0,0,20,0">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Style="{StaticResource StatBulletStyle}" Fill="#60A5FA"></Rectangle>
                        <TextBlock Text="Luftfeuchtigkeit" Style="{StaticResource StatLabelStyle}" Foreground="#60A5FA"></TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding HumidityText}" Style="{StaticResource StatValueStyle}"></TextBlock>
                        <TextBlock Text=" %" Foreground="#60A5FA" FontSize="18" VerticalAlignment="Bottom"></TextBlock>
                    </StackPanel>

                    <TextBlock Text="{Binding HumidityDeltaText}" Style="{StaticResource StatSubStyle}"></TextBlock>
                    <TextBlock Text="{Binding HumidityRatingText}" Style="{StaticResource StatSubStyle}"></TextBlock>
                </StackPanel>

                <Border Grid.Column="3" Style="{StaticResource StatDividerStyle}" Margin="0,0,20,0"></Border>

                <StackPanel Grid.Column="4">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Style="{StaticResource StatBulletStyle}" Fill="#FBBF24"></Rectangle>
                        <TextBlock Text="Luftdruck" Style="{StaticResource StatLabelStyle}" Foreground="#FBBF24"></TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding AirPressureText}" Style="{StaticResource StatValueStyle}"></TextBlock>
                        <TextBlock Text=" hPa" Foreground="#FBBF24" FontSize="18" VerticalAlignment="Bottom"></TextBlock>
                    </StackPanel>

                    <TextBlock Text="{Binding AirPressureDeltaText}" Style="{StaticResource StatSubStyle}"></TextBlock>
                    <TextBlock Text="{Binding AirPressureRatingText}" Style="{StaticResource StatSubStyle}"></TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chart -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" MinHeight="250">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <StackPanel Margin="16,0,0,0">
                            <TextBlock Text="Min" Style="{StaticResource ChartStatLabelStyle}"></TextBlock>
                            <TextBlock Text="{Binding TempMinText}" Style="{StaticResource ChartStatValueStyle}"></TextBlock>
                        </StackPanel>

                        <StackPanel Margin="16,0,0,0">
                            <TextBlock Text="Ø" Style="{StaticResource ChartStatLabelStyle}"></TextBlock>
                            <TextBlock Text="{Binding TempAvgText}" Style="{StaticResource ChartStatValueStyle}"></TextBlock>
                        </StackPanel>

                        <StackPanel Margin="16,0,0,0">
                            <TextBlock Text="Max" Style="{StaticResource ChartStatLabelStyle}"></TextBlock>
                            <TextBlock Text="{Binding TempMaxText}" Style="{StaticResource ChartStatValueStyle}"></TextBlock>
                        </StackPanel>

                        <StackPanel Margin="16,0,0,0">
                            <TextBlock Text="heute" Style="{StaticResource ChartStatLabelStyle}"></TextBlock>
                            <TextBlock Text="{Binding TempDeltaTodayText}" Style="{StaticResource ChartStatValueStyle}" Foreground="#34D8B8"></TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Temperatur" Style="{StaticResource CardTitleStyle}"></TextBlock>
                        <TextBlock Text="{Binding UpdatedAtText, StringFormat='Aktualisiert {0}'}"  Style="{StaticResource CardSubtitleStyle}"></TextBlock>
                    </StackPanel>
                </DockPanel>

                <lvc:CartesianChart Grid.Row="1"
                    Series="{Binding TemperatureSeries}"
                    XAxes="{Binding XAxes}"
                    YAxes="{Binding YAxes}"
                    Background="Transparent" />
            </Grid>
        </Border>
        
        <!--City Weather-->

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="16,0,0,0" >
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Wetter weltweit" Style="{StaticResource CardTitleStyle}"></TextBlock>
                        <TextBlock Text="Min/Max heute" Style="{StaticResource CardSubtitleStyle}"></TextBlock>
                    </StackPanel>

                    <StackPanel Margin="16,0,0,0" HorizontalAlignment="Right">
                        <Button Style="{StaticResource EditButtonStyle}" Command="{Binding CmdEditCities}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"></TextBlock>
                                <TextBlock Text="Bearbeiten"></TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </DockPanel>
                
                <UniformGrid Grid.Row="1" Columns="5" Margin="0,5,0,0">
                    <Border Margin="0,5,10,0" Style="{StaticResource BoxBorderStyle}"  Visibility="{Binding City1NameText, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding City1NameText}" Style="{StaticResource CityNameStyle}"></TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding City1MinTempText}" Style="{StaticResource CityNameStyle}" Foreground="#60A5FA"></TextBlock>
                                <TextBlock Text=" °" Style="{StaticResource ChartStatLabelStyle}" Foreground="#60A5FA"></TextBlock>
                                <TextBlock Text=" | " Style="{StaticResource ChartStatLabelStyle}"></TextBlock>
                                <TextBlock Text="{Binding City1MaxTempText}" Style="{StaticResource ChartStatLabelStyle}"  Foreground="#FBBF24"></TextBlock>
                                <TextBlock Text=" °" Style="{StaticResource ChartStatLabelStyle}"  Foreground="#FBBF24"></TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,5,10,0"  Style="{StaticResource BoxBorderStyle}" Visibility="{Binding City2NameText, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding City2NameText}" Style="{StaticResource CityNameStyle}"></TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding City2MinTempText}" Style="{StaticResource CityNameStyle}" Foreground="#60A5FA"></TextBlock>
                                <TextBlock Text=" °" Style="{StaticResource ChartStatLabelStyle}" Foreground="#60A5FA"></TextBlock>
                                <TextBlock Text=" | " Style="{StaticResource ChartStatLabelStyle}"></TextBlock>
                                <TextBlock Text="{Binding City2MaxTempText}" Style="{StaticResource ChartStatLabelStyle}"  Foreground="#FBBF24"></TextBlock>
                                <TextBlock Text=" °" Style="{StaticResource ChartStatLabelStyle}"  Foreground="#FBBF24"></TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,5,10,0" Style="{StaticResource BoxBorderStyle}"  Visibility="{Binding City3NameText, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding City3NameText}" Style="{StaticResource CityNameStyle}"></TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding City3MinTempText}" Style="{StaticResource CityNameStyle}" Foreground="#60A5FA"></TextBlock>
                                <TextBlock Text=" °" Style="{StaticResource ChartStatLabelStyle}" Foreground="#60A5FA"></TextBlock>
                                <TextBlock Text=" | " Style="{StaticResource ChartStatLabelStyle}"></TextBlock>
                                <TextBlock Text="{Binding City3MaxTempText}" Style="{StaticResource ChartStatLabelStyle}"  Foreground="#FBBF24"></TextBlock>
                                <TextBlock Text=" °" Style="{StaticResource ChartStatLabelStyle}"  Foreground="#FBBF24"></TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,5,10,0" Style="{StaticResource BoxBorderStyle}"  Visibility="{Binding City4NameText, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding City4NameText}" Style="{StaticResource CityNameStyle}"></TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding City4MinTempText}" Style="{StaticResource CityNameStyle}" Foreground="#60A5FA"></TextBlock>
                                <TextBlock Text=" °" Style="{StaticResource ChartStatLabelStyle}" Foreground="#60A5FA"></TextBlock>
                                <TextBlock Text=" | " Style="{StaticResource ChartStatLabelStyle}"></TextBlock>
                                <TextBlock Text="{Binding City4MaxTempText}" Style="{StaticResource ChartStatLabelStyle}"  Foreground="#FBBF24"></TextBlock>
                                <TextBlock Text=" °" Style="{StaticResource ChartStatLabelStyle}"  Foreground="#FBBF24"></TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,5,0,0" Style="{StaticResource BoxBorderStyle}" Visibility="{Binding City5NameText, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding City5NameText}" Style="{StaticResource CityNameStyle}"></TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding City5MinTempText}" Style="{StaticResource CityNameStyle}" Foreground="#60A5FA"></TextBlock>
                                <TextBlock Text=" °" Style="{StaticResource ChartStatLabelStyle}" Foreground="#60A5FA"></TextBlock>
                                <TextBlock Text=" | " Style="{StaticResource ChartStatLabelStyle}"></TextBlock>
                                <TextBlock Text="{Binding City5MaxTempText}" Style="{StaticResource ChartStatLabelStyle}"  Foreground="#FBBF24"></TextBlock>
                                <TextBlock Text=" °" Style="{StaticResource ChartStatLabelStyle}"  Foreground="#FBBF24"></TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>

    </Grid>
</Window>
