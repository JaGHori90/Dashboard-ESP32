<Window x:Class="Wpf.EditCityListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf"
        mc:Ignorable="d"
        Title="Städte bearbeiten" Height="480" Width="620" Background="#0B0F1A"
        WindowStartupLocation="CenterScreen">
    <Border Style="{StaticResource CardBorderStyle}" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" VerticalAlignment="Top" Command="{Binding CmdClose}" Style="{StaticResource EditButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Fertig"/>
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Wetter weltweit" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="{Binding SubtitleText}" Style="{StaticResource CardSubtitleStyle}"/>
                </StackPanel>
            </DockPanel>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectCities}" AlternationCount="999">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource BoxBorderStyle}" Margin="0,0,0,10" Padding="10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Width="18" VerticalAlignment="Center"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToDisplayNumberConverter}}"/>
                                <Button DockPanel.Dock="Right" Content="✕"
                                        Style="{StaticResource EditButtonStyle}"
                                        Command="{Binding DataContext.RemoveCityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                                <!-- Text="{Binding}" binds to the collection's string item itself; there is no
                                     settable path to write an edit back into an ObservableCollection<string>,
                                     so this is display-only (renaming isn't a supported action, only add/remove). -->
                                <TextBox Text="{Binding}" IsReadOnly="True" Margin="10,0" VerticalAlignment="Center"
                                         Style="{StaticResource CityNameTextBoxStyle}"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Content="Hinzufügen" Margin="8,0,0,0"
                        Command="{Binding AddCityCommand}"
                        Background="#34D8B8" Foreground="#0B0F1A" Padding="14,8" BorderThickness="0"/>
                <Border Style="{StaticResource BoxBorderStyle}" Padding="0">
                    <Grid>
                        <TextBlock Text="Stadt hinzufügen ..." Style="{StaticResource MutedTextStyle}"
                                   Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding NewCityName, Converter={StaticResource EmptyStringToVisibilityConverter}, ConverterParameter=Invert}"/>
                        <TextBox Text="{Binding NewCityName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CityNameTextBoxStyle}" Padding="10" VerticalAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddCityCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </Border>
</Window>
